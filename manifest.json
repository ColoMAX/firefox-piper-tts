{
  "manifest_version": 3,
  "name": "Firefox Piper TTS",
  "version": "1.0.0",
  "description": "Add Piper TTS voices to Firefox Reader View",
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": ["src/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["about:reader?*"],
      "js": ["src/content-script.js"],
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/piper-worker.js"],
      "matches": ["about:reader?*"]
    }
  ]
}
